# 拷贝为 .env 后按需修改；docker compose 会自动读取。
# UID/GID 必须与「拥有目标仓库、~/.claude、~/.config/gh 的宿主机用户」一致，
# 否则容器内 git 会因属主不符拒绝操作仓库（镜像已设 safe.directory 兜底，但文件属主会错乱）。
# 大多数 Linux 开发机默认就是 1000:1000。
UID=1000
GID=1000

# 宿主机映射到容器 3100 的端口
PORT=3100

# 目标代码仓库的共同父目录（会被挂载到容器 /workspace）。
# projects.json 里每个 repo 的 path 写成 /workspace/<repo名>。
REPOS_ROOT=./repos
